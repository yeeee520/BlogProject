# 安装到 /etc/blog-backend.env 后执行：sudo chmod 600 /etc/blog-backend.env
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:mysql://localhost:3306/blog?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=GMT%2b8&allowPublicKeyRetrieval=true
DB_USERNAME=bloguser
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION=7200000
COS_SECRET_ID=REPLACE_WITH_LEAST_PRIVILEGE_COS_SECRET_ID
COS_SECRET_KEY=REPLACE_WITH_LEAST_PRIVILEGE_COS_SECRET_KEY
COS_BUCKET_NAME=REPLACE_WITH_COS_BUCKET_NAME
COS_REGION=ap-guangzhou
COS_PRIVATE_URL_MINUTES=10
APP_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
ALBUM_SYNC_ACL_ON_STARTUP=false
BOOTSTRAP_ADMINS_ENABLED=false
# 仅首次初始化管理员时取消注释，使用两组不同且至少14字符的全新密码：
# BOOTSTRAP_YEEEE_PASSWORD=REPLACE_WITH_NEW_STRONG_PASSWORD
# BOOTSTRAP_CHIP_PASSWORD=REPLACE_WITH_ANOTHER_NEW_STRONG_PASSWORD
